# Database Configuration
# Banco oficial do projeto (RFC-003 / DB-01): dg_master_db
DB_URL=jdbc:mysql://localhost:3306/dg_master_db?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true

# Para executar pelo IntelliJ com MySQL local, use seu usuário do MySQL.
DB_USERNAME=root
DB_PASSWORD=

# Necessária somente para o MySQL do Docker Compose.
MYSQL_ROOT_PASSWORD=

# Chave exigida para criar contas de Gerente (/admin e /api/auth/cadastro-gerente)
DGMASTER_ADMIN_KEY=
